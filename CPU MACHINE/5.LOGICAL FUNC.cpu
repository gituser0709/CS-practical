	<ConditionBit name="CARRY-BIT" bit="0" register="module.Register3d118309" halt="false" id="module.ConditionBit38959fb1" />
	<ConditionBit name="HALT-BIT" bit="0" register="module.Register3322abc9" halt="true" id="module.ConditionBit14266913" />

	<!--............. rams ..........................-->
	<RAM name="MAIN" length="4096" cellSize="16" id="module.RAM57540512" />

	<!--............. set ...........................-->
	<!-- none -->

	<!--............. test ..........................-->
	<!-- none -->

	<!--............. increment .....................-->
	<Increment name="INCR-PC" register="module.Register1bcb0f5a" delta="1" id="microinstruction.Increment66ecdd3a" />

	<!--............. shift .........................-->
	<!-- none -->

	<!--............. logical .......................-->
	<Logical name="AC&lt;-AC nand DR" type="NAND" source1="module.Register40dfd247" source2="module.Register2f9e8c7d" destination="module.Register40dfd247" id="microinstruction.Logical40c3b9cd" />
	<Logical name="AC&lt;-AC nor DR" type="NOR" source1="module.Register40dfd247" source2="module.Register2f9e8c7d" destination="module.Register40dfd247" id="microinstruction.Logical456a2c3f" />
	<Logical name="AC&lt;-AC'" type="NOT" source1="module.Register40dfd247" source2="module.Register40dfd247" destination="module.Register40dfd247" id="microinstruction.Logical6e773bd" />
	<Logical name="AC&lt;-AC^DR" type="AND" source1="module.Register40dfd247" source2="module.Register2f9e8c7d" destination="module.Register40dfd247" id="microinstruction.Logical60c8d8f5" />
	<Logical name="AC&lt;-ACorDR" type="OR" source1="module.Register40dfd247" source2="module.Register2f9e8c7d" destination="module.Register40dfd247" id="microinstruction.Logical7440ebf1" />
	<Logical name="AC&lt;AC xor DR" type="XOR" source1="module.Register40dfd247" source2="module.Register2f9e8c7d" destination="module.Register40dfd247" id="microinstruction.Logical3bd7e1f6" />

	<!--............. arithmetic ....................-->
	<Arithmetic name="AC&lt;-AC+DR" type="ADD" source1="module.Register40dfd247" source2="module.Register2f9e8c7d" destination="module.Register40dfd247" carryBit="module.ConditionBit38959fb1" id="microinstruction.Arithmetic7290ae41" />

	<!--............. branch ........................-->
	<!-- none -->

	<!--............. transferRtoR ..................-->
	<TransferRtoR name="AR&lt;-IR(4-15)" source="module.Register406d8e4e" srcStartBit="4" dest="module.Register46516410" destStartBit="0" numBits="12" id="microinstruction.TransferRtoR55d93ff1" />
	<TransferRtoR name="AR&lt;-PC" source="module.Register1bcb0f5a" srcStartBit="0" dest="module.Register46516410" destStartBit="0" numBits="12" id="microinstruction.TransferRtoR22d2dccd" />

	<!--............. transferRtoA ..................-->
	<!-- none -->

	<!--............. transferAtoR ..................-->
	<!-- none -->

	<!--............. decode ........................-->
	<Decode name="DECODE-IR" ir="module.Register406d8e4e" id="microinstruction.Decode22d7d0a0" />

	<!--............. set condition bit .............-->
	<SetCondBit name="HALT" bit="module.ConditionBit14266913" value="1" id="microinstruction.SetCondBit55c2901d" />

	<!--............. io ............................-->
	<IO name="INPUT" direction="input" type="integer" buffer="module.Register40dfd247" connection="[console]" id="microinstruction.IO49781be3" />
	<IO name="OUTPUT" direction="output" type="integer" buffer="module.Register40dfd247" connection="[console]" id="microinstruction.IO7df892b5" />

	<!--............. memory access .................-->
	<MemoryAccess name="DR&lt;-MAIN[AR]" direction="read" memory="module.RAM57540512" data="module.Register2f9e8c7d" address="module.Register46516410" id="microinstruction.MemoryAccess61360f7a" />
	<MemoryAccess name="IR&lt;-MAIN[AR]" direction="read" memory="module.RAM57540512" data="module.Register406d8e4e" address="module.Register46516410" id="microinstruction.MemoryAccess20b53939" />
	<MemoryAccess name="MAIN[AR]&lt;-AC" direction="write" memory="module.RAM57540512" data="module.Register40dfd247" address="module.Register46516410" id="microinstruction.MemoryAccess299b89cf" />

	<!--............. end ...........................-->
	<End id="microinstruction.End10cfdb73" />

	<!--............. comment ...........................-->
	<!-- none -->

	<!--............. global equs ..................-->
	<!-- none -->

