	</MachineInstruction>

	<MachineInstruction name="NOT" opcode="2" format="REGISTER" >
		<Microinstruction microRef="microinstruction.Logical6e773bd" />
		<Microinstruction microRef="microinstruction.End10cfdb73" />
	</MachineInstruction>

	<MachineInstruction name="OR" opcode="1" format="OP ADDR" >
		<Microinstruction microRef="microinstruction.MemoryAccess61360f7a" />
		<Microinstruction microRef="microinstruction.Logical7440ebf1" />
		<Microinstruction microRef="microinstruction.End10cfdb73" />
	</MachineInstruction>

	<MachineInstruction name="STA" opcode="6" format="OP ADDR" >
		<Microinstruction microRef="microinstruction.MemoryAccess299b89cf" />
		<Microinstruction microRef="microinstruction.End10cfdb73" />
	</MachineInstruction>

	<MachineInstruction name="HLT" opcode="e001" format="REGISTER" >
		<Microinstruction microRef="microinstruction.SetCondBit55c2901d" />
		<Microinstruction microRef="microinstruction.End10cfdb73" />
