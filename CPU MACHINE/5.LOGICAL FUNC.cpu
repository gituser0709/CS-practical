	<!-- none -->

	<!--............. registers .....................-->
	<Register name="AC" width="16" id="module.Register40dfd247" />
	<Register name="AR" width="12" id="module.Register46516410" />
	<Register name="DR" width="16" id="module.Register2f9e8c7d" />
	<Register name="E" width="1" id="module.Register3322abc9" />
	<Register name="I" width="1" id="module.Registerdd11a00" />
	<Register name="IR" width="16" id="module.Register406d8e4e" />
	<Register name="PC" width="12" id="module.Register1bcb0f5a" />
	<Register name="S" width="1" id="module.Register3d118309" />

	<!--............. register arrays ...............-->
