		<Microinstruction microRef="microinstruction.End10cfdb73" />
	</MachineInstruction>

	<MachineInstruction name="INP" opcode="f800" format="REGISTER" >
		<Microinstruction microRef="microinstruction.IO49781be3" />
		<Microinstruction microRef="microinstruction.End10cfdb73" />
