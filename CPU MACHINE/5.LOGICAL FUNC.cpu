	<FetchSequence>
		<Microinstruction microRef="microinstruction.TransferRtoR22d2dccd" />
		<Microinstruction microRef="microinstruction.MemoryAccess20b53939" />
		<Microinstruction microRef="microinstruction.Increment66ecdd3a" />
		<Microinstruction microRef="microinstruction.TransferRtoR55d93ff1" />
		<Microinstruction microRef="microinstruction.Decode22d7d0a0" />
	</FetchSequence>

	<!--............. machine instructions ..........-->

	<MachineInstruction name="AND" opcode="0" format="OP ADDR" >
		<Microinstruction microRef="microinstruction.MemoryAccess61360f7a" />
		<Microinstruction microRef="microinstruction.Logical60c8d8f5" />
		<Microinstruction microRef="microinstruction.End10cfdb73" />
	</MachineInstruction>

	<MachineInstruction name="NAND" opcode="5" format="OP ADDR" >
