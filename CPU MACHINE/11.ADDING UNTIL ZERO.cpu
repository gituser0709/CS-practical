		<Microinstruction microRef="microinstruction.Arithmetic5d565068" />
		<Microinstruction microRef="microinstruction.End149bd88f" />
	</MachineInstruction>

	<MachineInstruction name="STA" opcode="6" format="OP ADDR" >
