		<Microinstruction microRef="microinstruction.End149bd88f" />
	</MachineInstruction>

	<MachineInstruction name="STOP" opcode="e001" format="REGISTER" >
		<Microinstruction microRef="microinstruction.SetCondBit1f037286" />
		<Microinstruction microRef="microinstruction.End149bd88f" />
	</MachineInstruction>

	<MachineInstruction name="WRITE" opcode="f400" format="REGISTER" >
		<Microinstruction microRef="microinstruction.IO22880ef8" />
		<Microinstruction microRef="microinstruction.End149bd88f" />
	</MachineInstruction>

	<MachineInstruction name="READ" opcode="f800" format="REGISTER" >
