	<ConditionBit name="CARRY-BIT" bit="0" register="module.Register6cfa40ad" halt="false" id="module.ConditionBit188853bf" />
	<ConditionBit name="HALT-BIT" bit="0" register="module.Register4356ed3c" halt="true" id="module.ConditionBit69e35648" />

	<!--............. rams ..........................-->
	<RAM name="MAIN" length="4096" cellSize="16" id="module.RAM7acd574f" />

	<!--............. set ...........................-->
	<Set name="PC&lt;-AR" register="module.Register1831719a" start="0" numBits="12" value="0" id="microinstruction.CpusimSet3300b4a8" />

	<!--............. test ..........................-->
	<Test name="IF(AC!=0) SKIP-1" register="module.Register6ac99764" start="0" numBits="16" comparison="NE" value="0" omission="1" id="microinstruction.Test3cc9ab10" />
	<Test name="IF(AC&gt;0) SKIP-1" register="module.Register6ac99764" start="0" numBits="16" comparison="GT" value="0" omission="1" id="microinstruction.Test4fdb2ee2" />

	<!--............. increment .....................-->
	<Increment name="INCR-PC" register="module.Register1831719a" delta="1" id="microinstruction.Increment440c8f93" />

