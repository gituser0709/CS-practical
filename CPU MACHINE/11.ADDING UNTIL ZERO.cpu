		<Microinstruction microRef="microinstruction.MemoryAccess1b50cb0d" />
		<Microinstruction microRef="microinstruction.Increment440c8f93" />
		<Microinstruction microRef="microinstruction.TransferRtoR5ada59cd" />
		<Microinstruction microRef="microinstruction.Decode7039a9f9" />
	</FetchSequence>

	<!--............. machine instructions ..........-->

	<MachineInstruction name="LDA" opcode="4" format="OP ADDR" >
		<Microinstruction microRef="microinstruction.MemoryAccess1fc31d31" />
		<Microinstruction microRef="microinstruction.TransferRtoR5bc2850e" />
		<Microinstruction microRef="microinstruction.End149bd88f" />
	</MachineInstruction>

	<MachineInstruction name="JUMP" opcode="1" format="OP ADDR" >
