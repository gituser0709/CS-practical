	<Logical name="AC&lt;-AC^DR" type="AND" source1="module.Register6ac99764" source2="module.Register2744817e" destination="module.Register6ac99764" id="microinstruction.Logical7d06384c" />

	<!--............. arithmetic ....................-->
	<Arithmetic name="AC&lt;-AC+DR" type="ADD" source1="module.Register6ac99764" source2="module.Register2744817e" destination="module.Register6ac99764" carryBit="module.ConditionBit188853bf" id="microinstruction.Arithmetic5d565068" />

	<!--............. branch ........................-->
