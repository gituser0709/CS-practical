	</Field>

	<!--............. FileChannels .................-->
	<!-- none -->

	<!--............. registers .....................-->
	<Register name="AC" width="16" id="module.Register6ac99764" />
	<Register name="AR" width="12" id="module.Register1a0c81be" />
	<Register name="DR" width="16" id="module.Register2744817e" />
	<Register name="E" width="1" id="module.Register4356ed3c" />
	<Register name="I" width="1" id="module.Register65022085" />
	<Register name="IR" width="16" id="module.Register1bfd5cea" />
	<Register name="PC" width="12" id="module.Register1831719a" />
	<Register name="S" width="1" id="module.Register6cfa40ad" />

	<!--............. register arrays ...............-->
