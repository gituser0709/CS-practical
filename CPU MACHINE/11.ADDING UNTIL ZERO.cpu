	<TransferRtoR name="AC&lt;-DR" source="module.Register2744817e" srcStartBit="0" dest="module.Register6ac99764" destStartBit="0" numBits="16" id="microinstruction.TransferRtoR5bc2850e" />
	<TransferRtoR name="AR&lt;-IR(4-15)" source="module.Register1bfd5cea" srcStartBit="4" dest="module.Register1a0c81be" destStartBit="0" numBits="12" id="microinstruction.TransferRtoR5ada59cd" />
	<TransferRtoR name="AR&lt;-PC" source="module.Register1831719a" srcStartBit="0" dest="module.Register1a0c81be" destStartBit="0" numBits="12" id="microinstruction.TransferRtoR3cb1227b" />
	<TransferRtoR name="PC&lt;-AR" source="module.Register1a0c81be" srcStartBit="0" dest="module.Register1831719a" destStartBit="0" numBits="12" id="microinstruction.TransferRtoR649f5009" />

	<!--............. transferRtoA ..................-->
	<!-- none -->

	<!--............. transferAtoR ..................-->
	<!-- none -->

