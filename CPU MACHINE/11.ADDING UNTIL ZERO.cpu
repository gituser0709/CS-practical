	<SetCondBit name="HALT" bit="module.ConditionBit69e35648" value="1" id="microinstruction.SetCondBit1f037286" />

	<!--............. io ............................-->
	<IO name="INPUT" direction="input" type="integer" buffer="module.Register6ac99764" connection="[console]" id="microinstruction.IO171f549a" />
	<IO name="OUTPUT" direction="output" type="integer" buffer="module.Register6ac99764" connection="[console]" id="microinstruction.IO22880ef8" />

	<!--............. memory access .................-->
	<MemoryAccess name="DR&lt;-MAIN[AR]" direction="read" memory="module.RAM7acd574f" data="module.Register2744817e" address="module.Register1a0c81be" id="microinstruction.MemoryAccess1fc31d31" />
	<MemoryAccess name="IR&lt;-MAIN[AR]" direction="read" memory="module.RAM7acd574f" data="module.Register1bfd5cea" address="module.Register1a0c81be" id="microinstruction.MemoryAccess1b50cb0d" />
	<MemoryAccess name="MAIN[AR]&lt;-AC" direction="write" memory="module.RAM7acd574f" data="module.Register6ac99764" address="module.Register1a0c81be" id="microinstruction.MemoryAccess7606f779" />

	<!--............. end ...........................-->
	<End id="microinstruction.End149bd88f" />

	<!--............. comment ...........................-->
	<!-- none -->

